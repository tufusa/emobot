{
  "name": "emobot",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev src/index.ts",
    "deploy": "wrangler deploy --minify src/index.ts",
    "format": "biome format --write src",
    "lint": "biome lint --write src",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write src",
    "ci:check": "biome check src",
    "ci:build": "wrangler deploy --dry-run --minify src/index.ts"
  },
  "dependencies": {
    "discord-api-types": "^0.38.0",
    "discord-interactions": "^4.1.0",
    "hono": "^4.5.10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^7.0.0",
    "wrangler": "^4.0.0"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
