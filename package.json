{
  "name": "emobot",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev src/index.ts",
    "deploy": "wrangler deploy --minify src/index.ts",
    "format": "biome format --write src",
    "lint": "biome lint --write src",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write src",
    "ci:check": "biome check src",
    "ci:build": "wrangler deploy --dry-run --minify src/index.ts"
  },
  "dependencies": {
    "discord-api-types": "^0.38.0",
    "discord-interactions": "^4.1.0",
    "hono": "^4.5.10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^7.0.0",
    "wrangler": "^4.0.0"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
