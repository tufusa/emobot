{
  "name": "emobot",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev src/index.ts",
    "deploy": "wrangler deploy --minify src/index.ts",
    "format": "biome format --write src",
    "lint": "biome lint --write src",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write src",
    "ci:check": "biome check src",
    "ci:build": "wrangler deploy --dry-run --minify src/index.ts"
  },
  "dependencies": {
    "discord-api-types": "^0.38.0",
    "discord-interactions": "^4.1.0",
    "hono": "^4.5.10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@cloudflare/workers-types": "^4.20240821.1",
    "typescript": "^7.0.0",
    "wrangler": "^4.0.0"
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af"
}
