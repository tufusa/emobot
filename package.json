{
  "name": "emobot",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev src/index.ts",
    "deploy": "wrangler deploy --minify src/index.ts",
    "format": "biome format --write src",
    "lint": "biome lint --write src",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write src",
    "ci:check": "biome check src",
    "ci:build": "wrangler deploy --dry-run --minify src/index.ts"
  },
  "dependencies": {
    "discord-api-types": "^0.38.0",
    "discord-interactions": "^4.1.0",
    "hono": "^4.5.10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@cloudflare/workers-types": "^4.20240821.1",
    "typescript": "^7.0.0",
    "wrangler": "^4.0.0"
  },
  "packageManager": "pnpm@12.3.1+sha512.3c14c15408d1489d350f8ed7f93361d26cc707054f6849a4eea3bb7407ff4fe4564b413a1c421a773a176ab1168a8df1c7d548f2cd0dc7d344f58c4e680a5b18"
}
